#!/bin/sh
MSG=$(git log -1 --pretty=%B | sed -e 's/[[:space:]]*$//' | sed -e '/^$/d' | tail -n 1)
case "$MSG" in
  *--build) ;;
  *) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel)
ENV_FILE="$ROOT/.jenkins.env"
if [ ! -f "$ENV_FILE" ]; then
  echo "[jenkins] Missing $ENV_FILE - build not started." >&2
  exit 0
fi
. "$ENV_FILE"

if [ -z "$JENKINS_URL" ] || [ -z "$JENKINS_JOB" ] || [ -z "$JENKINS_USER" ] || [ -z "$JENKINS_TOKEN" ]; then
  echo "[jenkins] Set JENKINS_URL, JENKINS_JOB, JENKINS_USER, JENKINS_TOKEN in .jenkins.env" >&2
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "[jenkins] Pushing '$BRANCH'..."
if ! git push origin "$BRANCH"; then
  echo "[jenkins] Push failed - build not started." >&2
  exit 0
fi

URL="${JENKINS_URL%/}/job/$JENKINS_JOB/build"
echo "[jenkins] Triggering build: $URL"
CODE=$(curl -s -o /dev/null -w "%{http_code}" -X POST -u "$JENKINS_USER:$JENKINS_TOKEN" "$URL")
case "$CODE" in
  200|201) echo "[jenkins] Build queued." ;;
  *) echo "[jenkins] Error: HTTP $CODE" >&2 ;;
esac
exit 0
